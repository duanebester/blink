+# Bytes
+# -----
+
+# Every def here but Bytes.mask, Bytes.nth, Bytes.list_eq, Bytes.cells and
+# the UTF-8 steps runs natively in C (comp.ts's OPERATIONS), on the shared
+# block; its body is what it means, and what JS runs.
+
+def Bytes.mask(xs: List<&2, U32>) -> List<&2, U32>:
+  match xs:
+    case Nil{}:
+      Nil{}
+    case h <> t:
+      (h .&. 255 : U32) <> Bytes.mask(t)
+
+def Bytes.nth(xs: List<&2, U32>, i: Nat) -> U32:
+  match xs i:
+    case Nil{} _:
+      0
+    case h <> t 0n:
+      h
+    case h <> t 1n+p:
+      Bytes.nth(t, p)
+
+def Bytes.list_eq(xs: List<&2, U32>, ys: List<&2, U32>) -> Bool:
+  match xs ys:
+    case Nil{} Nil{}:
+      True{}
+    case x <> xt y <> yt:
+      Bool.and(U32.is_eq(x, y), Bytes.list_eq(xt, yt))
+    case _ _:
+      False{}
+
+def Bytes.cells(a: Array<U32>, acc: List<&2, U32>) -> List<&2, U32>:
+  match a:
+    case ALeaf{x}:
+      x <> acc
+    case ANode{xs, ys}:
+      Bytes.cells(xs, Bytes.cells(ys, acc))
+
+# A list's values, each mod 256, as Bytes. (Bytes{xs} with a value past
+# 255 stops a compiled program, as a Nat past its range does.)
+def Bytes.of_list(xs: List<&2, U32>) -> Bytes:
+  Bytes{Bytes.mask(xs)}
+
+def Bytes.empty() -> Bytes:
+  Bytes{Nil{}}
+
+# An Array<U32> builder's first n cells, each mod 256, frozen into Bytes.
+def Bytes.freeze(a: Array<U32>, n: Nat) -> Bytes:
+  Bytes.of_list(List.take(&2, U32, Bytes.cells(a, Nil{}), n))
+
+def Bytes.to_list(b: Bytes) -> List<&2, U32>:
+  match b:
+    case Bytes{data}:
+      data
+
+def Bytes.length(b: Bytes) -> Nat:
+  match b:
+    case Bytes{data}:
+      List.length(&2, U32, data)
+
+# The n bytes from o, fewer past the end. Compiled, a slice shares the
+# block: O(1), no byte copied.
+def Bytes.slice(b: Bytes, o: Nat, n: Nat) -> Bytes:
+  match b:
+    case Bytes{data}:
+      Bytes{List.take(&2, U32, List.drop(&2, U32, data, o), n)}
+
+def Bytes.take(b: Bytes, n: Nat) -> Bytes:
+  match b:
+    case Bytes{data}:
+      Bytes{List.take(&2, U32, data, n)}
+
+def Bytes.drop(b: Bytes, o: Nat) -> Bytes:
+  match b:
+    case Bytes{data}:
+      Bytes{List.drop(&2, U32, data, o)}
+
+# Byte i, 0 past the end; the big-endian U16 and U32 from byte i.
+def Bytes.get(b: Bytes, i: Nat) -> U32:
+  match b:
+    case Bytes{data}:
+      Bytes.nth(data, i)
+
+def Bytes.be16(b: Bytes, +i: Nat) -> U32:
+  match b:
+    case Bytes{+data}:
+      ((Bytes.nth(data, i) << 8n) .|. Bytes.nth(data, 1n+i) : U32)
+
+def Bytes.be32(b: Bytes, +i: Nat) -> U32:
+  match b:
+    case Bytes{+data}:
+      ((((Bytes.nth(data, i) << 24n) .|. (Bytes.nth(data, 1n+i) << 16n))
+        .|. (Bytes.nth(data, 2n+i) << 8n)) .|. Bytes.nth(data, 3n+i) : U32)
+
+def Bytes.concat(a: Bytes, b: Bytes) -> Bytes:
+  match a b:
+    case Bytes{xs} Bytes{ys}:
+      Bytes{List.append(&2, U32, xs, ys)}
+
+# The same bytes. Compiled, in a block of their own: a small slice kept
+# long need not keep its whole read alive.
+def Bytes.copy(b: Bytes) -> Bytes:
+  b
+
+def Bytes.eq(a: Bytes, b: Bytes) -> Bool:
+  match a b:
+    case Bytes{xs} Bytes{ys}:
+      Bytes.list_eq(xs, ys)
+
+# UTF-8 decoding with WHATWG's replacement policy, as Bend's own TCP text
+# codec decodes, including an incomplete last character. From Bend's
+# demos/io_http_fetch, by way of Blink.
+type Bytes.Utf8 is Data:
+  Bytes.Utf8{left: U32, code: U32, low: U32, high: U32, text: String}
+
+def Bytes.utf8.start(+b: U32, +text: String) -> Bytes.Utf8:
+  +left = Bool.pick(U32, U32.is_lt(b, 224), 1,
+    Bool.pick(U32, U32.is_lt(b, 240), 2, 3))
+  Bool.pick(Bytes.Utf8, U32.is_lt(b, 128),
+    Bytes.Utf8{0, 0, 128, 191, SCon{Chr{b}, text}},
+    Bool.pick(Bytes.Utf8, Bool.or(U32.is_lt(b, 194), U32.is_gt(b, 244)),
+      Bytes.Utf8{0, 0, 128, 191, SCon{Chr{65533}, text}},
+      Bytes.Utf8{left, U32.and(b, U32.shrn(63, U32.to_nat(left))),
+        Bool.pick(U32, U32.is_eq(b, 224), 160,
+          Bool.pick(U32, U32.is_eq(b, 240), 144, 128)),
+        Bool.pick(U32, U32.is_eq(b, 237), 159,
+          Bool.pick(U32, U32.is_eq(b, 244), 143, 191)), text}))
+
+def Bytes.utf8.more(+b: U32, +left: U32, +code: U32, +text: String, valid: Bool) -> Bytes.Utf8:
+  match valid:
+    case False{}:
+      Bytes.utf8.start(b, SCon{Chr{65533}, text})
+    case True{}:
+      +next = U32.sub(left, 1)
+      +value = U32.or(U32.shln(code, 6n), U32.and(b, 63))
+      Bytes.Utf8{next, value, 128, 191,
+        Bool.pick(String, U32.is_zero(next), SCon{Chr{value}, text}, text)}
+
+def Bytes.utf8.byte(state: Bytes.Utf8, +b: U32) -> Bytes.Utf8:
+  match state:
+    case Bytes.Utf8{left, code, low, high, text}:
+      match left:
+        case 0:
+          Bytes.utf8.start(b, text)
+        case _:
+          Bytes.utf8.more(b, left, code, text, Bool.and(U32.is_ge(b, low), U32.is_le(b, high)))
+
+def Bytes.utf8.finish(state: Bytes.Utf8) -> String:
+  match state:
+    case Bytes.Utf8{left, code, low, high, +text}:
+      String.reverse(Bool.pick(String, U32.is_zero(left), text, SCon{Chr{65533}, text}))
+
+# The bytes as UTF-8 text.
+def Bytes.utf8(b: Bytes) -> String:
+  Bytes.utf8.finish(List.foldl(~&2, ~U32, ~Bytes.Utf8, ~(state => x => Bytes.utf8.byte(state, x)),
+    Bytes.to_list(b), Bytes.Utf8{0, 0, 128, 191, ""}))
+
 # Map
 # ---
 
