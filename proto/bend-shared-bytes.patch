+// Bytes
+// =====
+
+// Base's Bytes (#1573). A value is a slice: an ARR block of 4 words,
+// [blob, off, len, 0], wrapped in a reference count at birth (as a Chan's
+// block is), so a shared Data node may hold it. Its blob is a BUF block
+// holding its length in word 0 and its bytes packed from word 1, wrapped
+// too, so slices and copies share it; term_drop frees each block with its
+// last reference. Every op consumes its Bytes arguments.
+
+#if !DEVICE
+
+static Term io_str(Env e, const char* p, u64 n);
+
+#ifdef CID(Con)
+#define bytes_is_con(t) (term_aux(t) == CID(Con))
+#else
+#define bytes_is_con(t) 0
+#endif
+
+// A new blob of n bytes, at *p (NULL if the heap is out).
+static Term blob_new(Env e, u64 n, u8** p) {
+  u32 w = cls_fit((u32)(1 + (n + 7) / 8));
+  u64 l = heap_alloc(e, w);
+  *p = NULL;
+  if (err_seen(e.mem)) {
+    return 0;
+  }
+  e.mem[l] = n;
+  *p = (u8*)(e.mem + l + 1);
+  return rfc_wrap(e, term_blk(false, w + 1, l), 1);
+}
+
+static Term bytes_make(Env e, Term blob, u64 off, u64 len) {
+  u64 l = heap_alloc(e, 2);
+  if (err_seen(e.mem)) {
+    return 0;
+  }
+  e.mem[l]     = blob;
+  e.mem[l + 1] = off;
+  e.mem[l + 2] = len;
+  e.mem[l + 3] = 0;
+  return rfc_wrap(e, term_blk(true, 2, l), 1);
+}
+
+// Where b's bytes start, and how many.
+static u8* bytes_ptr(Env e, Term b, u64* len) {
+  u64 l = term_peek(e.mem, b);
+  *len = e.mem[l + 2];
+  return (u8*)(e.mem + term_peek(e.mem, e.mem[l]) + 1) + e.mem[l + 1];
+}
+
+static Term bytes_of_mem(Env e, const u8* q, u64 n) {
+  u8* p;
+  Term blob = blob_new(e, n, &p);
+  if (p) {
+    memcpy(p, q, n);
+  }
+  return bytes_make(e, blob, 0, n);
+}
+
+// Bytes{xs} (a value past 255 stops) or, masked, Bytes.of_list(xs).
+static Term bytes_new_list(Env e, Term xs, u32 mask) {
+  u64 n = 0;
+  for (Term s = xs; bytes_is_con(s); n += 1) {
+    s = e.mem[term_peek(e.mem, s) + 1];
+  }
+  u8* p;
+  Term blob = blob_new(e, n, &p);
+  for (u64 i = 0; bytes_is_con(xs); i += 1) {
+    Term fb[2];
+    spare_free(e, cls_fit(2), ctr_take(e, xs, 2, fb));
+    if (!mask && fb[0] > 255) {
+      err_post(e.mem, ERR_BYTE);
+    }
+    if (p) {
+      p[i] = (u8)fb[0];
+    }
+    xs = fb[1];
+  }
+  return bytes_make(e, blob, 0, n);
+}
+
+#define bytes_of_list(e, xs) bytes_new_list(e, xs, 1)
+
+static Term bytes_to_list(Env e, Term b) {
+  u64 n;
+  u8* p = bytes_ptr(e, b, &n);
+#if defined(CID(Con)) && defined(CID(Nil))
+  Term xs = term_pak(CID(Nil), 0);
+  for (u64 i = n; i > 0; i -= 1) {
+    u64 nd = heap_alloc(e, 1);
+    e.mem[nd]     = p[i - 1];
+    e.mem[nd + 1] = CID_T[CID(Con)].hot ? rfc_seal(e, xs) : xs;
+    xs = term_ctr(CID(Con), nd);
+  }
+#else
+  Term xs = 0;
+#endif
+  term_sink(e, b);
+  return xs;
+}
+
+static u64 bytes_length(Env e, Term b) {
+  u64 n;
+  bytes_ptr(e, b, &n);
+  term_sink(e, b);
+  return n;
+}
+
+// b cut to its bytes [s, s + m): in place if this is its only reference.
+static Term bytes_cut(Env e, Term b, u64 s, u64 m) {
+  u64 l = term_peek(e.mem, b);
+  u64 off = e.mem[l + 1] + s;
+  if (term_rfc(b) && (a32_load(a32_at(e.mem, term_loc(b))) & RFC_CNT) == 1) {
+    e.mem[l + 1] = off;
+    e.mem[l + 2] = m;
+    return b;
+  }
+  Term blob = term_keep(e, e.mem[l], 1);
+  term_sink(e, b);
+  return bytes_make(e, blob, off, m);
+}
+
+static Term bytes_slice(Env e, Term b, u64 o, u64 n) {
+  u64 len = e.mem[term_peek(e.mem, b) + 2];
+  u64 s = o < len ? o : len;
+  return bytes_cut(e, b, s, n < len - s ? n : len - s);
+}
+
+#define bytes_take(e, b, n) bytes_slice(e, b, 0, n)
+
+static Term bytes_drop(Env e, Term b, u64 o) {
+  u64 len = e.mem[term_peek(e.mem, b) + 2];
+  u64 s = o < len ? o : len;
+  return bytes_cut(e, b, s, len - s);
+}
+
+static u64 bytes_be(Env e, Term b, u64 i, u32 k) {
+  u64 n;
+  u8* p = bytes_ptr(e, b, &n);
+  u32 r = 0;
+  for (u32 j = 0; j < k; j += 1) {
+    r = (r << 8) | (i + j < n ? p[i + j] : 0);
+  }
+  term_sink(e, b);
+  return r;
+}
+
+#define bytes_get(e, b, i)  bytes_be(e, b, i, 1)
+#define bytes_be16(e, b, i) bytes_be(e, b, i, 2)
+#define bytes_be32(e, b, i) bytes_be(e, b, i, 4)
+
+// An empty side costs nothing: the other is the answer.
+static Term bytes_concat(Env e, Term a, Term b) {
+  u64 an, bn;
+  u8* ap = bytes_ptr(e, a, &an);
+  u8* bp = bytes_ptr(e, b, &bn);
+  if (an == 0 || bn == 0) {
+    term_sink(e, an == 0 ? a : b);
+    return an == 0 ? b : a;
+  }
+  u8* p;
+  Term blob = blob_new(e, an + bn, &p);
+  if (p) {
+    memcpy(p, ap, an);
+    memcpy(p + an, bp, bn);
+  }
+  term_sink(e, a);
+  term_sink(e, b);
+  return bytes_make(e, blob, 0, an + bn);
+}
+
+static Term bytes_copy(Env e, Term b) {
+  u64 n;
+  u8* p = bytes_ptr(e, b, &n);
+  Term r = bytes_of_mem(e, p, n);
+  term_sink(e, b);
+  return r;
+}
+
+static u64 bytes_eq(Env e, Term a, Term b) {
+  u64 an, bn;
+  u8* ap = bytes_ptr(e, a, &an);
+  u8* bp = bytes_ptr(e, b, &bn);
+  u64 r = an == bn && memcmp(ap, bp, an) == 0;
+  term_sink(e, a);
+  term_sink(e, b);
+  return r;
+}
+
+static Term bytes_utf8(Env e, Term b) {
+  u64 n;
+  u8* p = bytes_ptr(e, b, &n);
+  Term r = io_str(e, (const char*)p, n);
+  term_sink(e, b);
+  return r;
+}
+
+static Term bytes_freeze(Env e, Term a, u64 n) {
+  u64 la = term_peek(e.mem, a);
+  u64 k = 1ull << blk_cls(a);
+  u64 m = n < k ? n : k;
+  u8* p;
+  Term blob = blob_new(e, m, &p);
+  for (u64 i = 0; p && i < m; i += 1) {
+    p[i] = (u8)*blk_ptr(e.mem, la, (u32)i);
+  }
+  term_sink(e, a);
+  return bytes_make(e, blob, 0, m);
+}
+
+#endif
+
