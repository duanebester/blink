+# PROTOTYPE (#1573): a byte value. Bytes{len, buf}: len bytes, byte i in
+# slot i of buf, which has the fewest 2^d slots that hold them, zero past
+# len. A receive fills it straight from the read, with no list.
+type Bytes is Type:
+  Bytes{len: U32, buf: Array<U32>}
+
+def TCP.recv_buf(sock: Socket, max: U32) ->
+  IO(Socket & Result<&1, &1, U32 & String, Maybe<&1, Bytes>>):
+  import "./effs/tcp_recv.c"
