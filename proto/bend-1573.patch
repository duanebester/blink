+
+// PROTOTYPE (#1573): a receive into Bytes{len, buf}, a byte a slot.
+#ifdef CID(Bytes)
+
+static Term io_bytes(Env e, const char* p, u64 n) {
+  u32 d = 0;
+  while ((1ull << d) < n) {
+    d += 1;
+  }
+  BLK_ALLOC(l, blk_wcls(false, d))
+  for (u64 i = 0; i < (1ull << d); i += 1) {
+    blk_write(e.mem, false, l, (u32)i, i < n ? (uint8_t)p[i] : 0);
+  }
+  return io_node(e, CID(Bytes), (Term)(u32)n, term_blk(false, d, l));
+}
+
+static Term tcp_recv_buf_more(Env e, IoWork* w) {
+  return tcp_recv_with(e, w, tcp_recv_buf_more, io_bytes);
+}
+
+#endif
+
+#ifdef CID(TCP.recv_buf)
+
+Term tcp_recv_buf_run(Env e, Term* f, IoWork* w) {
+  return tcp_recv_start(e, f, w, tcp_recv_buf_more, 0);
+}
+
+static void __attribute__((constructor)) tcp_recv_buf_use(void) {
+  io_eff(CID(TCP.recv_buf), tcp_recv_buf_run);
+}
+
+#endif
+
+#ifdef CID(TCP.try_recv_buf)
+
+Term tcp_try_recv_buf_run(Env e, Term* f, IoWork* w) {
+  return tcp_recv_start(e, f, w, tcp_recv_buf_more, io_until(f[2]));
+}
+
+static void __attribute__((constructor)) tcp_try_recv_buf_use(void) {
+  io_eff(CID(TCP.try_recv_buf), tcp_try_recv_buf_run);
+}
+
+#endif
